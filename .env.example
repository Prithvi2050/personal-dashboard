DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEFAULT_TIMEZONE=Asia/Kolkata

# Reserved for the separate Gmail consent flow in a later sprint.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sprint 9: use a separate Google Cloud project for Gmail, not Supabase login credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters. Server-only; preserve securely.
GMAIL_TOKEN_ENCRYPTION_KEY=
AI_API_KEY=
# Sprint 7: server-only OpenAI configuration; keep real keys in .env.local only.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
NEWS_API_KEY=
# Server-only USDA FoodData Central key. Never prefix with NEXT_PUBLIC_.
USDA_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
